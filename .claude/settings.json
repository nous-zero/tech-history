{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__preview_logs",
      "mcp__visualize__read_me",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__143def12-c3dc-499d-9011-481d102449f7__discover_zapier_actions",
      "mcp__143def12-c3dc-499d-9011-481d102449f7__list_enabled_zapier_actions",
      "mcp__143def12-c3dc-499d-9011-481d102449f7__inspect_zapier_actions"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3) && \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/roster_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*execute_zapier_write_action.*",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3) && \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_upload_gate.py\"",
            "timeout": 45,
            "statusMessage": "업로드 게이트: 전송 본문을 원본과 대조 중"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python || command -v python3) && \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify_git_push.py\"",
            "timeout": 60,
            "statusMessage": "푸시 게이트: 원격 최신 여부 확인 중"
          }
        ]
      }
    ]
  }
}
